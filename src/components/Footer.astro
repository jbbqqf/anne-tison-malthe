          <span class="monogram" aria-hidden="true">
            <svg viewBox="0 0 64 64" fill="none" aria-hidden="true">
              <path d="M32 25 C29.2 21 26 18 22.8 18 C18 23 14.8 32 15.8 39 C18.5 37 21 34.2 23.2 32.5 C22 39 21 46 20 51.5 Q32 53.5 44 51.5 C43 46 42 39 40.8 32.5 C43 34.2 45.5 37 48.2 39 C49.2 32 46 23 41.2 18 C38 18 34.8 21 32 25 Z" fill="currentColor"/>
