  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand" href={base} style="margin-bottom:18px">
          <span class="monogram" aria-hidden="true">
            <svg viewBox="0 0 64 64" fill="none" aria-hidden="true">
              <path d="M32 31 L26.5 17.5 Q23 16.5 19.5 17 C14 21.5 12 31 13 40.5 Q15.5 39.5 18 38 C20 36.5 21 35 22 33.5 C20 40.5 18 47.5 17 54 Q16.5 56 18.5 56.2 Q32 57.5 45.5 56.2 Q47.5 56 47 54 C46 47.5 44 40.5 42 33.5 C43 35 44 36.5 46 38 Q48.5 39.5 51 40.5 C52 31 50 21.5 44.5 17 Q41 16.5 37.5 17.5 Z" fill="currentColor"/>
              <rect x="28.9" y="17.5" width="2.4" height="13.5" rx="1.1" fill="#fff"/>
              <rect x="32.7" y="17.5" width="2.4" height="13.5" rx="1.1" fill="#fff"/>
