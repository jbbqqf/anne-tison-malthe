          <li><a href={`${base}le-cabinet/`}>Parcours et engagements</a></li>
          <li><a href={`${base}expertises/`}>Domaines d'intervention</a></li>
          <li><a href={`${base}rendez-vous/`}>Honoraires et premier échange</a></li>
          <li><a href={`${base}mentions-legales/`}>Mentions légales</a></li>
        </ul>
      </div>

      <div>
        <h4>Contact</h4>
        <ul>
          <li><a href="tel:+33660791448">06&nbsp;60&nbsp;79&nbsp;14&nbsp;48</a></li>
          <li><a href="mailto:anne.tison-malthe@avocat.fr">anne.tison-malthe@avocat.fr</a></li>
          <li>63 boulevard Malesherbes<br>75008 Paris</li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} Anne Tison-Malthé · FWD Legal · Avocate au barreau de Paris (toque B0505)</span>
      <span><a href={`${base}mentions-legales/`}>Mentions légales</a> · <a href={`${base}mentions-legales/#confidentialite`}>Confidentialité</a></span>
    </div>
  </div>
</footer>
