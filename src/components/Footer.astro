---
const year = 2026;
const base = import.meta.env.BASE_URL;
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand" href={base} style="margin-bottom:18px">
          <span class="monogram" aria-hidden="true">
            <svg viewBox="0 0 64 64" fill="none" aria-hidden="true">
              <path d="M8.5 50 L18.4 14 H29.2 L39.1 50 H30.3 L28.4 42.4 H19.2 L17.3 50 Z M20.8 35.2 H26.8 L23.8 23.2 Z" fill="#fff"/>
              <path d="M37.5 14 H58.5 V21.9 H52.3 V50 H43.7 V21.9 H37.5 Z" fill="#fff"/>
            </svg>
          </span>
          <span class="brand-text">
            <span class="brand-name">Anne Tison-Malthé</span>
            <span class="brand-sub" style="color:rgba(250,246,239,0.55)">FWD&nbsp;Legal · Avocate</span>
          </span>
        </a>
        <p style="max-width:34ch;color:rgba(250,246,239,0.72)">
          Avocate au barreau de Paris. Restructuring, procédures collectives et
          accompagnement des dirigeants, en français, allemand et anglais.
        </p>
      </div>

      <div>
        <h4>Le cabinet</h4>
