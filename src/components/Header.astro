---
const { path = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
const links = [
  { href: base, label: 'Accueil' },
  { href: `${base}le-cabinet/`, label: 'Le cabinet' },
  { href: `${base}expertises/`, label: 'Expertises' },
  { href: `${base}rendez-vous/`, label: 'Honoraires et RDV' },
];
const isActive = (href) =>
  href === base ? path === base : path.startsWith(href);
---
<header class="site-header">
  <div class="container">
    <a class="brand" href={base} aria-label="Anne Tison-Malthé, FWD Legal, accueil">
      <span class="monogram" aria-hidden="true">
        <svg viewBox="0 0 64 64" fill="none" aria-hidden="true">
          <g transform="matrix(0.01887,0,0,-0.01887,9.215,45.461)" fill="#FFFFFF"><path d="M268.8 539.2H778L781.2 520H263.6ZM323 6.4Q323 4.2 321.1 2.1Q319.2 0 315.4 0H-3.8Q-7.2 0 -9.3 2.1Q-11.4 4.2 -11.4 6.4Q-11.4 10.2 -8.4 11.8Q-5.4 13.4 -2.6 14L35 25.4Q67 36.4 99.5 71.2Q132 106 153.6 179.2L477.2 1279.4Q488.8 1318.4 477.5 1342Q466.2 1365.6 435.6 1378.8Q424.4 1386.6 418.8 1388.7Q413.2 1390.8 413.2 1393.6Q413.2 1397.4 415.6 1398.7Q418 1400 422.8 1400H811.6Q816 1400 818.2 1398.7Q820.4 1397.4 820.4 1393.6Q820.4 1390.8 815.6 1387.8Q810.8 1384.8 798.8 1380Q775 1376.4 769.9 1366.7Q764.8 1357 773.2 1330.4L1176 66.4Q1183.8 43 1199.1 30.9Q1214.4 18.8 1237.6 15.8Q1243.8 14 1246.3 12.1Q1248.8 10.2 1248.8 6.4Q1248.8 4.2 1246.6 2.1Q1244.4 0 1240 0H798.8Q794.8 0 792.4 2.1Q790 4.2 790 6.4Q790 10.2 793.1 11.2Q796.2 12.2 802 14L849.6 21.6Q874.2 27.8 880 41.1Q885.8 54.4 878 78.8L492.8 1294.8L516.8 1347.2L172.2 175.6Q160.2 135 171.6 104.9Q183 74.8 211.9 54.7Q240.8 34.6 281.4 22.4L313.4 14Q318.8 12.8 320.9 11.2Q323 9.6 323 6.4Z"/><g transform="translate(1210.0,0)"><path d="M180.8 1400H1055.2Q1075.8 1400 1094 1406.7Q1112.2 1413.4 1125.5 1420.1Q1138.8 1426.8 1143.2 1426.8Q1145.8 1426.8 1147.9 1423.7Q1150 1420.6 1152.4 1406L1215.2 1022Q1217.2 1015 1216.1 1011.3Q1215 1007.6 1212 1006.4Q1209 1005.8 1206 1007.7Q1203 1009.6 1200.4 1014.4Q1135.2 1171.6 1081.1 1250.3Q1027 1329 978.3 1355.3Q929.6 1381.6 882.4 1381.6H762V54Q762 42 771.8 35.8Q781.6 29.6 800.8 26.4L881.6 14Q893.6 12.2 893.6 6.4Q893.6 0 884 0H360Q355.2 0 352.8 2.1Q350.4 4.2 350.4 6.4Q350.4 12.2 362.4 14L443.2 26.4Q463 29.6 472.5 35.8Q482 42 482 54V1381.6H361.6Q315.4 1381.6 267.4 1352.1Q219.4 1322.6 164.7 1243.4Q110 1164.2 43.6 1014.4Q41.4 1009.6 38.2 1007.7Q35 1005.8 32 1006.4Q29 1007.6 28.4 1011.3Q27.8 1015 28.8 1022L91.6 1406Q94 1420.6 96.3 1423.7Q98.6 1426.8 100.8 1426.8Q104.8 1426.8 116 1420.1Q127.2 1413.4 144.1 1406.7Q161 1400 180.8 1400Z"/></g></g>
        </svg>
      </span>
      <span class="brand-text">
        <span class="brand-name">Anne Tison-Malthé</span>
        <span class="brand-sub">FWD&nbsp;Legal · Avocate</span>
      </span>
    </a>

    <nav class="nav" id="primary-nav" aria-label="Navigation principale">
      {links.map((l) => (
        <a class="navlink" href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
      <a class="btn btn-primary" href={`${base}rendez-vous/`}>Prendre rendez-vous</a>
    </nav>

    <button class="nav-toggle" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="primary-nav">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>
</header>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.getElementById('primary-nav');
  toggle?.addEventListener('click', () => {
    const open = nav.getAttribute('data-open') === 'true';
    nav.setAttribute('data-open', String(!open));
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Ouvrir le menu' : 'Fermer le menu');
  });
</script>
