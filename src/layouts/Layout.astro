---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const {
  title = 'Anne Tison-Malthé, avocate en restructuring et procédures collectives à Paris',
  description = "Maître Anne Tison-Malthé, avocate au barreau de Paris. Restructuring, procédures collectives et défense des dirigeants. Accompagnement trilingue en français, allemand et anglais. Premier échange confidentiel.",
  path = Astro.url.pathname,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL(`${base}images/anne-portrait.jpg`, Astro.site).href;

// Schema.org : profil d'avocate, cabinet (LegalService + Person).
// NB : « FWD LEGAL » est le nom commercial à confirmer avec la cliente avant mise en production.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'LegalService',
  name: 'Anne Tison-Malthé · FWD Legal',
  description,
  url: Astro.site?.href,
  telephone: '+33660791448',
  email: 'anne.tison-malthe@avocat.fr',
  areaServed: 'France',
  priceRange: '€€',
  knowsLanguage: ['fr', 'de', 'en'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: '63 boulevard Malesherbes',
    postalCode: '75008',
    addressLocality: 'Paris',
    addressCountry: 'FR',
  },
  founder: {
    '@type': 'Person',
    name: 'Anne Tison-Malthé',
    jobTitle: 'Avocate au barreau de Paris',
    knowsLanguage: ['fr', 'de', 'en'],
    memberOf: { '@type': 'Organization', name: "Institut Français des Praticiens des Procédures Collectives (IFPPC)" },
  },
};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#1D2A38" />
    <!-- Aperçu non destiné au référencement : retirer cette ligne pour la mise en production. -->
    <meta name="robots" content="noindex, nofollow" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;1,9..144,400&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Aller au contenu</a>
    <Header path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Révélation douce au défilement
      if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          }
        }, { threshold: 0.12 });
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      } else {
        document.querySelectorAll('.reveal').forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>
